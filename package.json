{
  "name": "hireflow",
  "private": true,
  "description": "HireFlow monorepo — run frontend + backend together",
  "scripts": {
    "dev": "concurrently -n backend,frontend -c blue,green \"npm run dev --prefix backend\" \"npm run dev --prefix frontend\"",
    "dev:backend": "npm run dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "start:backend": "npm start --prefix backend",
    "dev:bg": "pm2 start ecosystem.config.cjs",
    "dev:bg:stop": "pm2 stop ecosystem.config.cjs",
    "dev:bg:restart": "pm2 restart ecosystem.config.cjs",
    "dev:bg:logs": "pm2 logs",
    "dev:bg:delete": "pm2 delete ecosystem.config.cjs"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
